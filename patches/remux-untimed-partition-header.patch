+    #[test]
+    fn test_parse_untimed_partition_header() {
+        // First two records of a Protect 7.3.70 file: untimed partition header
+        // (format F1 00, no DTS) followed by a clock sync.
+        let data: Vec<u8> = vec![
+            // Tag + format F1 00 + seq
+            0xa0, 0x00, 0x09, 0xa9, 0xf1, 0x00, 0x00, 0x00,
+            // SIZE = 20 (no DTS field)
+            0x00, 0x00, 0x00, 0x14,
+            // DATA (20 bytes)
+            0x00, 0x00, 0x00, 0x00, 0x3f, 0xfc, 0x54, 0xc4, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+            0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+            // BACK_SIZE = 32 (8+4+20+0)
+            0x00, 0x00, 0x00, 0x20,
+            // Clock sync: tag, format F9 02, seq, DTS, SIZE = 8, DATA, BACK_SIZE = 24
+            0xa0, 0xda, 0x7e, 0x04, 0xf9, 0x02, 0x00, 0x00,
+            0x20, 0xbb, 0x23, 0x73,
+            0x00, 0x00, 0x00, 0x08,
+            0x6a, 0xbd, 0xc5, 0xfa, 0x2d, 0x1e, 0xe7, 0x40,
+            0x00, 0x00, 0x00, 0x18,
+        ];
+        let mut cursor = Cursor::new(data);
+
+        let ph = read_record(&mut cursor).unwrap().unwrap();
+        assert_eq!(ph.track_id, 9);
+        assert_eq!(ph.dts, 0);
+        assert_eq!(ph.data_size, 20);
+        assert_eq!(ph.data_offset, 12);
+        assert_eq!(ph.total_size, 36);
+
+        let cs = read_record(&mut cursor).unwrap().unwrap();
+        assert_eq!(cs.file_offset, 36);
+        assert_eq!(cs.track_id, 0xDA7E);
+        assert_eq!(cs.dts, 0x20BB2373);
+        assert_eq!(cs.data_size, 8);
+    }
 }
